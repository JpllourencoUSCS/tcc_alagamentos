# Copie para ".env" (nunca commitado — está no .gitignore) e preencha com
# valores reais antes de "docker compose up -d".
POSTGRES_USER=alagamentos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=alagamentos

# Chave da API do OpenWeather (https://home.openweathermap.org/api_keys).
# Sem ela, o cálculo automático de risco usa só a Open-Meteo (sem chave); só com as
# duas fontes fora o POST /ocorrencias sem nivel_risco e o GET /risco respondem 503.
OPENWEATHER_API_KEY=
